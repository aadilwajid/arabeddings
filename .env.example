# Environment Configuration for ARA Beddings
# Copy this file to .env.local and fill in your values

# ============================================
# REQUIRED: Authentication
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
NODE_ENV=development

# ============================================
# REQUIRED: Email Configuration (SMTP)
# ============================================
# For Gmail, use App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@arabeddings.com

# ============================================
# OPTIONAL: SMS Configuration
# ============================================
# Twilio (International)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Nexmo/Vonage (International)
NEXMO_API_KEY=your-nexmo-api-key
NEXMO_API_SECRET=your-nexmo-api-secret
NEXMO_FROM_NUMBER=ARA Beddings

# Jazz SMS (Pakistan Local)
JAZZ_SMS_API_KEY=your-jazz-sms-api-key
JAZZ_SMS_MASK=ARA Beddings

# ============================================
# OPTIONAL: Admin Configuration
# ============================================
ADMIN_EMAIL=admin@arabeddings.com
ADMIN_PHONE=03160143039

# ============================================
# OPTIONAL: Application URLs
# ============================================
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ============================================
# OPTIONAL: External Services
# ============================================
# Google Analytics
NEXT_PUBLIC_GA_ID=

# Facebook Pixel
NEXT_PUBLIC_FB_PIXEL_ID=

# ============================================
# NOTES:
# ============================================
# 1. JWT_SECRET is REQUIRED for authentication to work
# 2. SMTP credentials are REQUIRED for email notifications
# 3. SMS credentials are OPTIONAL (fallback to logging if not configured)
# 4. Never commit .env.local to git
# 5. Use different values for development and production
# 6. Generate a strong JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
